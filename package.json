{
  "name": "nightpaws",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --names server,web --prefix-colors magenta,cyan \"pnpm --filter @nightpaws/server dev\" \"pnpm --filter @nightpaws/web dev\"",
    "dev:web": "pnpm --filter @nightpaws/web dev",
    "dev:server": "pnpm --filter @nightpaws/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "10.0.6",
    "typescript": "7.0.2"
  }
}
